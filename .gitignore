# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & temporary artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/screenshot_*.png

# env files (exclude secrets, allow example template)
.env*
!.env.example

# external repositories & tools
/shiba_repo/
/ponytail/
/work docs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
